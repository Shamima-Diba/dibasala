# Browser-safe values only. Supabase RLS must be enabled on every exposed table.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Never put GEMINI_API_KEY, Google OAuth client secrets, refresh tokens,
# SUPABASE_SECRET_KEY, or legacy service_role keys in VITE_* variables.
